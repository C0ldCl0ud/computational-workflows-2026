# this is the base image the container is built on. In this case, it is a slim version of the Debian operating system.
FROM debian:bookworm-slim

# these are the labels that are added to the image. They are metadata that can be used to identify the author of the image.
LABEL image.author.name="Matthias Lang"
LABEL image.author.email="matthias.lang@student.uni-tuebingen.de"

# install dependencies
RUN apt-get update && \
    apt-get install -y curl cowsay fortune && \
    rm -rf /var/lib/apt/lists/*

# add /usr/games to PATH so cowsay can be called directly
ENV PATH="/usr/games:${PATH}"

ENTRYPOINT ["sh", "-c", "fortune | cowsay"]
